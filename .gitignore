# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform plan files
*.tfplan
*.plan

# Terraform variable files that often contain secrets
*.tfvars
*.tfvars.json

# Terraform CLI config and crash logs
.terraformrc
terraform.rc
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
